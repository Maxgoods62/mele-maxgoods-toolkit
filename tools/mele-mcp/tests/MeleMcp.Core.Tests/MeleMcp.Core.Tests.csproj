<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests of MeleMcp.Core, and lectool run as a process. scripts/test.sh runs them; README.md in this folder says what is
       tested and why. The same MSTest as LEC's own tests. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.0.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MeleMcp.Core\MeleMcp.Core.csproj" />
  </ItemGroup>

</Project>
